{
  "name": "@local/cockpit",
  "version": "0.0.0",
  "private": true,
  "description": "An admin panel shell: a navigation on the left, the chosen mini-app (a custom element) on the right.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/main/index.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "source": "./src/main/react/index.ts",
      "default": "./dist/react.js"
    },
    "./locales/*.json": "./locales/*.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "loc": "node scripts/loc.mjs",
    "loc:all": "node scripts/loc.mjs --all",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dprint": "^0.57.4",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sloc": "0.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
