{
  "name": "@local/data-navigator",
  "version": "0.0.0",
  "private": true,
  "description": "A React data navigator: a data table with sorting, filtering, pagination, selection and actions.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "loc": "node scripts/loc.mjs",
    "library-variables": "node scripts/library-variables.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "antd": "^6.6.5",
    "dprint": "^0.57.4",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "sloc": "^0.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
