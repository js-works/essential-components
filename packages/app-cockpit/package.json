{
  "name": "@local/app-cockpit",
  "version": "0.0.0",
  "private": true,
  "description": "An admin panel shell: a navigation on the left, the chosen mini-app (a custom element) on the right.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
