    "loc": "node scripts/loc.mjs",
    "loc:all": "node scripts/loc.mjs --all"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "dprint": "^0.57.4",
    "sloc": "0.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
