{
  "name": "@local/data-table",
  "version": "0.0.0",
  "private": true,
  "description": "A React data table: a data table with sorting, filtering, pagination, selection and actions.",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./react": "./dist/react.js",
    "./themes": "./dist/themes.js"
  },
  "scripts": {
    "dev": "vite",
    "dev:preact": "vite --mode preact",
    "build": "tsc --noEmit && vite build && vite build --mode element",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "loc": "node scripts/loc.mjs",
    "library-variables": "node scripts/library-variables.mjs",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0"
  },
  "devDependencies": {
    "@mantine/core": "^9.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vanillajs-datepicker": "^1.3.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "antd": "^6.6.5",
    "dprint": "^0.57.4",
    "jsdom": "^30.1.0",
    "preact": "^10.29.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sloc": "^0.3.2",
    "typescript": "^7.0.2",
    "vanillajs-datepicker": "^1.3.4",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
