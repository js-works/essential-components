{
  "name": "@local/micro-app",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated building blocks for the cockpit's micro-apps (React, Mantine, TanStack Router, react-i18next).",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@local/data-table": "*",
    "@local/form-validation": "*",
    "@local/mantine-themes": "*",
    "@local/overlays": "*"
  },
  "devDependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@tanstack/react-router": "1.170.41",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dprint": "^0.57.4",
    "i18next": "^26.4.2",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@tanstack/react-router": "^1.170.0",
    "i18next": ">=26",
    "react": ">=19",
    "react-dom": ">=19",
    "react-i18next": ">=17",
    "zod": "^4"
  }
}
