{
  "name": "@local/login",
  "version": "0.0.0",
  "private": true,
  "description": "A generic login screen for apps, with Mantine (React).",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./style.css": "./dist/login.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "loc": "sloc src",
    "loc:all": "sloc . --exclude 'node_modules|dist|\\.config\\.'"
  },
  "devDependencies": {
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dprint": "^0.57.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sloc": "0.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "peerDependencies": {
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "react": ">=19",
    "react-dom": ">=19"
  }
}
