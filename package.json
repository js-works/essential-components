{
  "name": "essential-components",
  "version": "0.0.1",
  "private": true,
  "description": "The essential components (data navigator, file upload, overlays) as workspace packages, and one demo page for all of them.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "build:board-manager": "tsc --noEmit && vite build --config vite.board-manager.config.ts",
    "freeze-demo": "test ! -e old-demos/$npm_package_version || { echo \"old-demos/$npm_package_version exists already\"; exit 1; } && tsc --noEmit && vite build --base ./ --outDir old-demos/$npm_package_version",
    "typecheck": "tsc --noEmit",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@mantine/dates": "9.5.1",
    "@mantine/form": "9.5.1",
    "@react-pdf/renderer": "^4.9.0",
    "dayjs": "1.11.23",
    "pdfjs-dist": "^6.3.289",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dprint": "^0.57.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
