{
  "name": "essential-components",
  "version": "0.0.3",
  "private": true,
  "description": "The essential components (data table, file upload, overlays) as workspace packages, and one demo page for all of them.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "build:board-manager": "tsc --noEmit && vite build --config vite.board-manager.config.ts",
    "freeze-demo": "test ! -e old-demos/$npm_package_version || { echo \"old-demos/$npm_package_version exists already\"; exit 1; } && tsc --noEmit && vite build --base ./ --outDir old-demos/$npm_package_version",
    "typecheck": "tsc --noEmit",
    "format": "biome check --write && dprint fmt",
    "format:check": "biome check && dprint check"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@mantine/charts": "9.5.1",
    "@mantine/dates": "9.5.1",
    "@tanstack/react-query": "^5.104.0",
    "dayjs": "1.11.23",
    "react-i18next": "^17.0.15",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "recharts": "3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dprint": "^0.57.4",
    "i18next": "^26.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  }
}
